{
  "workspaces": {
    ".": {
      "entry": [
        "scripts/*.mjs"
      ],
      "ignoreDependencies": []
    },
    "packages/*": {
      "project": [
        "src/**/*.{ts,tsx}"
      ]
    },
    "tools/*": {
      "project": [
        "src/**/*.js"
      ]
    },
    "apps/web": {
      "ignoreDependencies": [
        "playwright"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "e2e/*.mjs"
      ]
    }
  },
  "ignore": [
    "tests/fixtures/**"
  ]
}